generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth.js v5 models ----

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  passwordHash  String?   // filled for email+password users
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())

  // Workspaces (M2)
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]

  // Notifications (M3): received + caused by this user
  notifications        Notification[]
  createdNotifications Notification[] @relation("NotificationActor")

  // Invites (M3): invites this user created
  invitesCreated Invite[] @relation("InviteCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Workspaces (M2) ----

model Workspace {
  id        String        @id @default(cuid())
  name      String
  logoUrl   String?
  type      WorkspaceType @default(TEAM)
  ownerId   String
  owner     User          @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt DateTime      @default(now())

  members  WorkspaceMember[]
  projects Project[]

  // Notifications (M3)
  notifications Notification[]

  // Invites (M3)
  invites Invite[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId]) // one membership per user per workspace
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

// ---- App models ----

model Project {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  progress    Int       @default(0)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String   @default("")
  status      String   @default("todo")
  priority    String   @default("medium")
  due         String   // "YYYY-MM-DD"
  assigneeId  String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ---- Notifications (M3) ----

enum NotificationType {
  INVITE_SENT
  INVITE_ACCEPTED
  MEMBER_JOINED
  TASK_ASSIGNED   // future: needs real member assignment
  CHAT_MESSAGE    // future: chat milestone
  WORKSPACE_RENAMED  // owner renamed the workspace
  WORKSPACE_DELETED  // owner deleted the workspace
}

model Notification {
  id          String           @id @default(cuid())
  userId      String           // recipient: whose bell this shows up in
  workspaceId String?          // optional: which workspace the event belongs to
  actorId     String?          // optional: which user caused the event
  type        NotificationType
  message     String           @db.Text
  link        String?          // route to open when clicked
  readAt      DateTime?        // null = unread
  createdAt   DateTime         @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])    // unread count query
  @@index([userId, createdAt]) // list query (newest first)
}

// ---- Invites (M3) ----

model Invite {
  id          String        @id @default(cuid())
  token       String        @unique // random unguessable value in the link
  email       String?       // optional: pre-bind the link to one email
  role        WorkspaceRole @default(MEMBER) // role granted on accept
  workspaceId String
  createdById String
  expiresAt   DateTime      // link stops working after this
  usedAt      DateTime?     // set when accepted -> one-time use
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InviteCreator", fields: [createdById], references: [id])

  @@index([workspaceId])
}
